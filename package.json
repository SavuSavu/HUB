    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "cheerio": "^1.0.0",
    "fake-indexeddb": "^6.0.0",
    "prettier": "^3.9.9",
    "robots-parser": "^3.0.1",
    "tailwindcss": "^4.0.0",
